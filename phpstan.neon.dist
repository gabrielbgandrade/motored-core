includes:
  - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
  level: 6
  paths:
    - motored-core.php
    - uninstall.php
    - src
  bootstrapFiles:
    - tests/phpstan-bootstrap.php
    - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
  scanDirectories:
    - vendor/php-stubs/woocommerce-stubs
  excludePaths:
    - vendor
