"{recovery_url}, {optout_url}, {store_name}"

#: src/Modules/Recovery/RecoveryAdmin.php:259
msgid "Unpaid order sequences"
msgstr "Secuencias de pedidos sin pagar"

#: src/Modules/Recovery/RecoveryAdmin.php:260
msgid ""
"Delays count from the moment the order entered that status. The e-mail "
"channel uses the \"Pending payment reminder\" e-mail in WooCommerce > "
"Settings > Emails."
