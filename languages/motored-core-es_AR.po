msgstr "Ya podés seguir tu pedido #%s:"


#: src/Modules/OrderTracking/OrderTrackingAdmin.php
msgid "Delay before sending (minutes)"
msgstr "Demora antes de enviar (minutos)"

#: src/Modules/OrderTracking/OrderTrackingAdmin.php
msgid "The WhatsApp and e-mail wait this long, so a \"completed\" message sent at the same time can carry the code instead."
msgstr "El WhatsApp y el e-mail esperan este tiempo, así un mensaje de \"completado\" enviado al mismo tiempo puede llevar el código."

#: src/Modules/OrderTracking/TrackingNotifier.php
msgid "Tracking e-mail could not be scheduled."
msgstr "No se pudo programar el e-mail de seguimiento."

#: src/Modules/OrderTracking/OrderTrackingAdmin.php
msgid "Preview"
msgstr "Vista previa"

#: src/Modules/OrderTracking/OrderTrackingAdmin.php
msgid "Add your carriers with their tracking URL: it must be https and contain {code}. Example: %s. The id is generated from the name and cannot be changed. \"Other / manual link\" is always available on the order. Leave the name empty to remove a row."
msgstr "Cargá tus transportistas con su URL de seguimiento: tiene que ser https y contener {code}. Ejemplo: %s. El id se genera a partir del nombre y no se puede cambiar. \"Otra / link manual\" siempre está disponible en el pedido. Dejá el nombre vacío para quitar una fila."

#: src/Modules/OrderTracking/OrderTrackingAdmin.php
msgid "Carrier \"%1$s\" was not saved: the URL template must start with https:// and contain {code}. Example: %2$s"
msgstr "El transportista \"%1$s\" no se guardó: el modelo de URL tiene que empezar con https:// y contener {code}. Ejemplo: %2$s"
