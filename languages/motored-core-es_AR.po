msgstr "Se envía cuando el pedido queda marcado como \"reembolsado\"."

#: src/Modules/OrderNotifications/OrderNotificationsAdmin.php:261
msgid "Customer note"
msgstr "Nota al cliente"

#: src/Modules/OrderNotifications/OrderNotificationsAdmin.php:262
msgid "Sent when a public customer note is added to the order."
msgstr "Se envía cuando agregás una nota visible para el cliente en el pedido."

#: src/Modules/OrderNotifications/OrderNotificationsAdmin.php:266
msgid "Admin: new order alert"
msgstr "Admin: aviso de nuevo pedido"

#: src/Modules/OrderNotifications/OrderNotificationsAdmin.php:267
msgid ""
"Optional internal WhatsApp alert sent to the Admin WhatsApp number above "
"when a new order arrives."
msgstr ""
"Aviso interno opcional enviado al número de WhatsApp del admin cuando entra "
"un pedido nuevo."

