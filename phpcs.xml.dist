<?xml version="1.0"?>
<ruleset name="Motored Core">
  <description>Coding standards for Motored Core.</description>

  <file>.</file>
  <exclude-pattern>/vendor/*</exclude-pattern>
  <exclude-pattern>/node_modules/*</exclude-pattern>
  <exclude-pattern>/build/*</exclude-pattern>
  <exclude-pattern>/reference/*</exclude-pattern>
  <exclude-pattern>/tests/*</exclude-pattern>

  <arg name="extensions" value="php"/>
  <arg name="colors"/>
  <arg value="ps"/>
  <arg name="cache" value=".phpcs.cache"/>
  <config name="minimum_supported_wp_version" value="6.8"/>
  <config name="testVersion" value="8.1-"/>

  <rule ref="WordPress-Extra"/>
  <rule ref="WordPress-Docs"/>

  <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
    <exclude-pattern>/templates/*</exclude-pattern>
    <properties>
      <property name="prefixes" type="array">
        <element value="motored"/>
        <element value="Motored"/>
      </property>
    </properties>
  </rule>

  <rule ref="WordPress.WP.Capabilities">
    <properties>
      <property name="custom_capabilities" type="array">
        <element value="manage_woocommerce"/>
      </property>
    </properties>
  </rule>

  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array">
        <element value="motored-core"/>
      </property>
    </properties>
  </rule>

  <!-- PSR-4 class files (src/Foo/Bar.php) instead of class-foo-bar.php. -->
  <rule ref="WordPress.Files.FileName.InvalidClassFileName">
    <exclude-pattern>/src/*</exclude-pattern>
  </rule>
  <rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
    <exclude-pattern>/src/*</exclude-pattern>
  </rule>
</ruleset>
